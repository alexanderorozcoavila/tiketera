# Entorno Local: Copia este archivo como .env

# Clave secreta para desarrollo local (Render generará una distinta)
SECRET_KEY=tu-clave-secreta-local

# Activa el modo Debug en local
DEBUG=True

# Hosts locales permitidos
ALLOWED_HOSTS=localhost,127.0.0.1

# Nota: Render inyectará su propia DATABASE_URL. Al no incluirla aquí,
# el sistema usará SQLite db.sqlite3 por defecto en tu máquina.
